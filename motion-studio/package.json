{
  "name": "piya-motion-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Piya's Motion Design Studio — one storyboard, two outputs: Remotion MP4 and a standalone GSAP/React motion site.",
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts Film out/seri-lestari-migrain.mp4 --codec=h264 --crf=23",
    "still": "remotion still src/remotion/index.ts Film",
    "web": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "sfx": "python3 tools/make_sfx.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@remotion/cli": "^4.0.543",
    "@remotion/media": "^4.0.543",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "remotion": "^4.0.543",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
