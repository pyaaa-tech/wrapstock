[
 {
  "start": 0.05,
  "end": 3.4,
  "text": "Hai everyone! Hari ini kita bercakap tentang"
 },
 {
  "start": 3.4,
  "end": 6.35,
  "text": "Gamogen daripada House of Healin —"
 },
 {
  "start": 6.35,
  "end": 9.05,
  "text": "suplemen berasaskan gamat yang dirumus"
 },
 {
  "start": 9.05,
  "end": 11.1,
  "text": "untuk menyokong kesihatan harian anda."
 },
 {
  "start": 11.55,
  "end": 13.65,
  "text": "Gamogen menggabungkan ekstrak gamat"
 },
 {
  "start": 13.65,
  "end": 16.85,
  "text": "Stichopus horrens, yang dikenali sebagai Gamodulin®,"
 },
 {
  "start": 16.85,
  "end": 19.5,
  "text": "bersama omega-3 dan omega-6"
 },
 {
  "start": 19.5,
  "end": 21.5,
  "text": "daripada minyak flaxseed,"
 },
 {
  "start": 21.5,
  "end": 24.2,
  "text": "vitamin E, vitamin B, chlorella"
 },
 {
  "start": 24.2,
  "end": 25.95,
  "text": "serta beta-karotena."
 },
 {
  "start": 26.25,
  "end": 29.6,
  "text": "Formula ini dipasarkan sebagai sokongan untuk"
 },
 {
  "start": 29.6,
  "end": 31.65,
  "text": "tenaga harian, keseimbangan nutrisi,"
 },
 {
  "start": 31.65,
  "end": 33.35,
  "text": "dan kesejahteraan umum."
 },
 {
  "start": 33.5,
  "end": 36.2,
  "text": "Ekstrak gamat juga telah lama menjadi"
 },
 {
  "start": 36.2,
  "end": 38.7,
  "text": "sebahagian daripada tradisi kesihatan di Asia Tenggara."
 },
 {
  "start": 39.2,
  "end": 42.2,
  "text": "Dari segi penyelidikan, kajian oleh penyelidik"
 },
 {
  "start": 42.2,
  "end": 44.75,
  "text": "Universiti Sains Malaysia pada 2025"
 },
 {
  "start": 44.75,
  "end": 47.9,
  "text": "mendapati ekstrak Stichopus horrens menunjukkan"
 },
 {
  "start": 47.9,
  "end": 50.45,
  "text": "trend penurunan paras glukosa darah"
 },
 {
  "start": 50.45,
  "end": 52.6,
  "text": "dan peningkatan toleransi senaman"
 },
 {
  "start": 52.6,
  "end": 54.15,
  "text": "dalam model kajian haiwan."
 },
 {
  "start": 54.15,
  "end": 57.95,
  "text": "Namun, kajian ini adalah kajian awal pada haiwan."
 },
 {
  "start": 58.2,
  "end": 60.85,
  "text": "Bagi manusia, Gamogen perlu dilihat sebagai"
 },
 {
  "start": 60.85,
  "end": 62.2,
  "text": "suplemen sokongan,"
 },
 {
  "start": 62.2,
  "end": 64.65,
  "text": "bukan pengganti ubat atau rawatan doktor."
 },
 {
  "start": 65.3,
  "end": 67.7,
  "text": "Gamogen sesuai bagi orang dewasa"
 },
 {
  "start": 67.7,
  "end": 69.95,
  "text": "yang ingin menambah sokongan nutrisi harian."
 },
 {
  "start": 70.25,
  "end": 72.25,
  "text": "Bagi individu yang mengambil ubat,"
 },
 {
  "start": 72.25,
  "end": 75.9,
  "text": "mengandung, menyusu, atau mempunyai keadaan kesihatan khusus,"
 },
 {
  "start": 75.9,
  "end": 78.55,
  "text": "berbincanglah dengan doktor atau farmasis"
 },
 {
  "start": 78.55,
  "end": 81,
  "text": "sebelum memulakan sebarang suplemen."
 },
 {
  "start": 81.65,
  "end": 84.3,
  "text": "Kesihatan bermula dengan pilihan harian:"
 },
 {
  "start": 84.3,
  "end": 87.55,
  "text": "pemakanan seimbang, rehat mencukupi, aktiviti fizikal,"
 },
 {
  "start": 87.55,
  "end": 89.6,
  "text": "dan sokongan nutrisi yang sesuai."
 },
 {
  "start": 89.95,
  "end": 92.25,
  "text": "Jika anda ingin mencuba Gamogen,"
 },
 {
  "start": 92.25,
  "end": 94.7,
  "text": "dapatkan nasihat profesional dan gunakannya"
 },
 {
  "start": 94.7,
  "end": 96.85,
  "text": "sebagai sebahagian daripada gaya hidup sihat."
 },
 {
  "start": 97.05,
  "end": 99.25,
  "text": "Gamogen House of Healin —"
 },
 {
  "start": 99.25,
  "end": 101.7,
  "text": "sokongan untuk kesejahteraan harian anda."
 }
]